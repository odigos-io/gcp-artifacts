# Google's deployer base ships kubectl built with an older Go than the Marketplace vulnerability scan
# accepts (v1.37.2 / go1.26.10 flagged CVE-2026-97040 for 1.40.0). Rebuild the same kubectl version
# with a fixed Go and drop it over the original. Check with `go version` on /opt/kubectl/*/kubectl
# whenever the base or Go is bumped; drop this stage once the base image's kubectl passes the scan.
FROM --platform=$BUILDPLATFORM golang:1.26.11 AS kubectl
ARG KUBECTL_VERSION=v1.37.2
RUN git clone --quiet --depth 1 --branch "${KUBECTL_VERSION}" https://github.com/kubernetes/kubernetes /src
WORKDIR /src
RUN v="${KUBECTL_VERSION#v}" \
    && pkg=k8s.io/client-go/pkg/version \
    && cpkg=k8s.io/component-base/version \
    && ld="" \
    && for p in $pkg $cpkg; do \
         ld="$ld -X $p.gitVersion=${KUBECTL_VERSION} -X $p.gitMajor=${v%%.*} -X $p.gitMinor=$(echo $v | cut -d. -f2)"; \
         ld="$ld -X $p.gitCommit=$(git rev-parse HEAD) -X $p.gitTreeState=clean"; \
         ld="$ld -X $p.buildDate=$(git show -s --format=%cI HEAD | sed 's/+00:00$/Z/')"; \
       done \
    && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 GOTOOLCHAIN=local \
       go build -trimpath -ldflags "-s -w $ld" -o /out/kubectl ./cmd/kubectl

FROM gcr.io/cloud-marketplace-tools/k8s/deployer_envsubst/onbuild:latest

COPY --from=kubectl /out/kubectl /opt/kubectl/v1.37/kubectl

# Verification-only schema overlay (generated by `make data-test`, not committed). Only the deployer's
# test mode (deploy_with_tests.sh, used by mpdev verify and Google's verification) reads /data-test;
# customer installs run deploy.sh and ignore it.
COPY data-test /data-test
