apiVersion: app.k8s.io/v1beta1
kind: Application
metadata:
  name: "$name"
  namespace: "$namespace"
  # Uninstall finalizer odigos.io/gcp-marketplace-helm-uninstall is added/removed by the installer pod (only on the
  # Application named in the installer Deployment's ownerReference), not declared here.
  annotations:
    marketplace.cloud.google.com/deploy-info: '{"partner_id": "V3NG7pbshZ", "product_id": "odigos", "partner_name": "Odigos"}'
    kubernetes-engine.cloud.google.com/icon: data:image/png;base64,
  labels:
    app.kubernetes.io/name: "$name"
spec:
  descriptor:
    type: odigos
    version: '1.23.0'
  selector:
    matchLabels:
      odigos.io/system-object: "true"
  # componentKinds list types for Application aggregation/UI (see Marketplace packaging docs).
  # Uninstall: installer adds finalizer on Application (via Deployment owner ref); informer + SIGTERM remove it.
  # https://docs.cloud.google.com/marketplace/docs/partners/kubernetes/create-app-package
  componentKinds:
  # admission / webhooks
  - group: admissionregistration.k8s.io
    kind: MutatingWebhookConfiguration
  - group: admissionregistration.k8s.io
    kind: ValidatingWebhookConfiguration
  - group: apiextensions.k8s.io
    kind: CustomResourceDefinition
  - group: apps
    kind: DaemonSet
  - group: apps
    kind: Deployment
  - group: autoscaling
    kind: HorizontalPodAutoscaler
  - group: batch
    kind: Job
  - group: policy
    kind: PodDisruptionBudget
  - group: rbac.authorization.k8s.io
    kind: ClusterRole
  - group: rbac.authorization.k8s.io
    kind: ClusterRoleBinding
  - group: rbac.authorization.k8s.io
    kind: Role
  - group: rbac.authorization.k8s.io
    kind: RoleBinding
  - group: storage.k8s.io
    kind: CSIDriver
  # core / v1
  - group: ''
    kind: ConfigMap
  - group: ''
    kind: ResourceQuota
  - group: ''
    kind: Secret
  - group: ''
    kind: Service
  - group: ''
    kind: ServiceAccount
