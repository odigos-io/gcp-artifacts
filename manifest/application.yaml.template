apiVersion: app.k8s.io/v1beta1
kind: Application
metadata:
  name: "$name"
  namespace: "$namespace"
  annotations:
    marketplace.cloud.google.com/deploy-info: '{"partner_id": "V3NG7pbshZ", "product_id": "odigos", "partner_name": "Odigos"}'
    kubernetes-engine.cloud.google.com/icon: data:image/png;base64,
  labels:
    app.kubernetes.io/name: "$name"
spec:
  descriptor:
    type: odigos
    version: '1.23.0'
  selector:
    matchLabels:
      odigos.io/system-object: "true"
  # Inject ownerReferences to the Application on matched resources so deleting the Application
  # can cascade via Kubernetes garbage collection. See:
  # https://github.com/kubernetes-sigs/application/blob/master/docs/api.md
  addOwnerRef: true
  # componentKinds must cover every resource type the Odigos Helm chart (and controllers) create
  # with odigos.io/system-object so the Application controller can adopt them when addOwnerRef is set.
  # See https://docs.cloud.google.com/marketplace/docs/partners/kubernetes/create-app-package
  componentKinds:
  # actions.odigos.io (CRDs from chart)
  - group: actions.odigos.io
    kind: AddClusterInfo
  - group: actions.odigos.io
    kind: DeleteAttribute
  - group: actions.odigos.io
    kind: ErrorSampler
  - group: actions.odigos.io
    kind: K8sAttributesResolver
  - group: actions.odigos.io
    kind: LatencySampler
  - group: actions.odigos.io
    kind: PiiMasking
  - group: actions.odigos.io
    kind: ProbabilisticSampler
  - group: actions.odigos.io
    kind: RenameAttribute
  - group: actions.odigos.io
    kind: ServiceNameSampler
  - group: actions.odigos.io
    kind: SpanAttributeSampler
  # admission / webhooks
  - group: admissionregistration.k8s.io
    kind: MutatingWebhookConfiguration
  - group: admissionregistration.k8s.io
    kind: ValidatingWebhookConfiguration
  - group: apiextensions.k8s.io
    kind: CustomResourceDefinition
  - group: apps
    kind: DaemonSet
  - group: apps
    kind: Deployment
  - group: autoscaling
    kind: HorizontalPodAutoscaler
  - group: batch
    kind: Job
  # odigos.io (CRDs + user-facing CR instances labeled as system objects)
  - group: odigos.io
    kind: Action
  - group: odigos.io
    kind: CollectorsGroup
  - group: odigos.io
    kind: Destination
  - group: odigos.io
    kind: InstrumentationConfig
  - group: odigos.io
    kind: InstrumentationInstance
  - group: odigos.io
    kind: InstrumentationRule
  - group: odigos.io
    kind: Processor
  - group: odigos.io
    kind: Sampling
  - group: odigos.io
    kind: Source
  - group: policy
    kind: PodDisruptionBudget
  - group: rbac.authorization.k8s.io
    kind: ClusterRole
  - group: rbac.authorization.k8s.io
    kind: ClusterRoleBinding
  - group: rbac.authorization.k8s.io
    kind: Role
  - group: rbac.authorization.k8s.io
    kind: RoleBinding
  - group: storage.k8s.io
    kind: CSIDriver
  # core / v1
  - group: ''
    kind: ConfigMap
  - group: ''
    kind: ResourceQuota
  - group: ''
    kind: Secret
  - group: ''
    kind: Service
  - group: ''
    kind: ServiceAccount
