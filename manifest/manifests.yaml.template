---
apiVersion: v1
kind: ConfigMap
metadata:
  name: $name-ubbagent-config
  namespace: $namespace
  labels:
    odigos.io/system-object: "true"
data:
  config.yaml: |
    identities:
      - name: gcp
        gcp:
          encodedServiceAccountKey: $AGENT_ENCODED_KEY
          consumerId: $AGENT_CONSUMER_ID

    endpoints:
      - name: on_disk
        disk:
          reportDir: /var/lib/ubbagent/reports
          expireSeconds: 3600
      - name: servicecontrol
        servicecontrol:
          identity: gcp
          serviceName: odigos.endpoints.odigos-public.cloud.goog
          consumerId: $AGENT_CONSUMER_ID

    metrics:
      - name: installed_nodes
        type: int
        aggregation:
          bufferSeconds: 60
        endpoints:
          - name: on_disk
          - name: servicecontrol
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: $name
  namespace: $namespace
  labels:
    app: $name
    odigos.io/system-object: "true"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: $name
  template:
    metadata:
      labels:
        app: $name
    spec:
      serviceAccountName: $installerServiceAccount
      containers:
        - name: installer
          image: $imageFull
          imagePullPolicy: Always
          command: ["/installer"]
          env:
            - name: ODIGOS_NAMESPACE
              value: "$namespace"
            - name: ODIGOS_VERSION
              value: "1.23.0"
            - name: ODIGOS_AUTOSCALER_IMAGE
              value: "$autoscalerImageFull"
            - name: ODIGOS_COLLECTOR_IMAGE
              value: "$collectorImageFull"
            - name: ODIGOS_INIT_CONTAINER_IMAGE
              value: "$initContainerImageFull"
            - name: ODIGOS_SCHEDULER_IMAGE
              value: "$schedulerImageFull"
            - name: ODIGOS_INSTRUMENTOR_IMAGE
              value: "$instrumentorImageFull"
            - name: ODIGOS_ODIGLET_IMAGE
              value: "$odigletImageFull"
            - name: ODIGOS_UI_IMAGE
              value: "$uiImageFull"
            - name: ODIGOS_INSTALLER_NAME
              value: "$name"
            - name: ODIGOS_INSTALLER_NAMESPACE
              value: "$namespace"
            - name: ODIGOS_ENTERPRISE_ODIGLET_IMAGE
              value: "$enterpriseOdigletImageFull"
            - name: ODIGOS_ENTERPRISE_INSTRUMENTOR_IMAGE
              value: "$enterpriseInstrumentorImageFull"
            - name: ODIGOS_ENTERPRISE_INIT_CONTAINER_IMAGE
              value: "$enterpriseInitContainerImageFull"
            - name: ODIGOS_ON_PREM_TOKEN
              value: "$onPremToken"
            - name: AGENT_LOCAL_PORT
              value: "4567"
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              cpu: 500m
              memory: 512Mi
        - name: ubbagent
          image: gcr.io/cloud-marketplace-tools/metering/ubbagent:latest
          env:
            - name: AGENT_CONFIG_FILE
              value: /etc/ubbagent/config.yaml
            - name: AGENT_LOCAL_PORT
              value: "4567"
            - name: AGENT_ENCODED_KEY
              valueFrom:
                secretKeyRef:
                  name: $reportingSecret
                  key: reporting-key
            - name: AGENT_CONSUMER_ID
              valueFrom:
                secretKeyRef:
                  name: $reportingSecret
                  key: consumer-id
          volumeMounts:
            - name: ubbagent-config
              mountPath: /etc/ubbagent
            - name: ubbagent-reports
              mountPath: /var/lib/ubbagent/reports
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
            limits:
              cpu: 100m
              memory: 128Mi
      volumes:
        - name: ubbagent-config
          configMap:
            name: $name-ubbagent-config
        - name: ubbagent-reports
          emptyDir: {}

