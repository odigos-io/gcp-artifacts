ORG ?= gcr.io/odigos-public
IMAGE_NAME = odigos/deployer
TAG ?= 1.40.0
# Marketplace requires every image to also carry the minor-version track tag (e.g. 1.40 for 1.40.0)
TRACK = $(basename $(TAG))
PLATFORMS = linux/amd64

# Full image reference
IMAGE = $(ORG)/$(IMAGE_NAME):$(TAG)
TRACK_IMAGE = $(ORG)/$(IMAGE_NAME):$(TRACK)

# Google verifies the deployer with schema defaults only, but onPremToken is required and has no
# default. data-test/schema.yaml gives it a default in test mode only. VERIFY_TOKEN_FILE must hold a
# dedicated short-lived token from the "Generate On-Prem Token" workflow in odigos-io/odigos: it ends
# up readable in the public deployer image. Never commit data-test/.
VERIFY_TOKEN_FILE ?=

.PHONY: data-test
data-test:
	@test -n "$(VERIFY_TOKEN_FILE)" || { echo "VERIFY_TOKEN_FILE is required (see RELEASING.md)"; exit 1; }
	@test -s "$(VERIFY_TOKEN_FILE)" || { echo "VERIFY_TOKEN_FILE $(VERIFY_TOKEN_FILE) is empty or missing"; exit 1; }
	@mkdir -p data-test
	@printf '%s\n' \
		'# Generated by `make data-test`. Verification-only defaults; do not commit.' \
		'properties:' \
		'  onPremToken:' \
		'    type: string' \
		"    default: '$$(tr -d '[:space:]' < $(VERIFY_TOKEN_FILE))'" \
		'    x-google-marketplace:' \
		'      type: MASKED_FIELD' \
		> data-test/schema.yaml
	@echo "Wrote data-test/schema.yaml"

# The Marketplace schema extractor needs the deployer as a single-platform image manifest, not an
# image index ("Image not found"), so skip the provenance/SBOM attestations that would wrap it in one.
.PHONY: push-image
push-image: data-test
	docker buildx build \
		--platform $(PLATFORMS) \
		--tag $(IMAGE) \
		--tag $(TRACK_IMAGE) \
		--provenance=false \
		--sbom=false \
		--output type=image,push=true,oci-mediatypes=false \
		--annotation "manifest:com.googleapis.cloudmarketplace.product.service.name=services/odigos.endpoints.odigos-public.cloud.goog" \
		.
